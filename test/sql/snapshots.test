# name: test/sql/snapshots.test
# description: SQL composition tests: JOIN, aggregation, CTAS, and ORDER BY
# group: [duckaki]

require duckaki

# 1. CTAS synthetic snapshot table
statement ok
CREATE TABLE daily_snapshot AS
SELECT 'sz000001' AS symbol, DATE '2024-01-02' AS trade_date, 9.18::DOUBLE AS open, 9.22::DOUBLE AS high, 9.10::DOUBLE AS low, 9.15::DOUBLE AS close, 1234500::BIGINT AS volume_shares, 2000.0::DOUBLE AS amount, 'CNY' AS currency, 'eastmoney' AS source, 'none' AS adjustment, TIMESTAMP '2024-01-05 08:00:00' AS fetched_at
UNION ALL
SELECT 'sz000001', DATE '2024-01-03', 9.15, 9.25, 9.12, 9.18, 2345600, 10000.0, 'CNY', 'eastmoney', 'none', TIMESTAMP '2024-01-05 08:00:00'
UNION ALL
SELECT 'sz000001', DATE '2024-02-01', 9.18, 9.20, 9.05, 9.10, 3456700, 22000.0, 'CNY', 'eastmoney', 'none', TIMESTAMP '2024-01-05 08:00:00';

# 2. JOIN with watchlist
statement ok
CREATE TEMP TABLE watchlist (symbol VARCHAR, target_price DOUBLE);

statement ok
INSERT INTO watchlist VALUES ('sz000001', 10.0);

query TRR
SELECT d.symbol, d.trade_date, round(w.target_price - d.close, 2)
FROM daily_snapshot d
JOIN watchlist w ON d.symbol = w.symbol
ORDER BY d.trade_date ASC;
----
sz000001	2024-01-02	0.85
sz000001	2024-01-03	0.82
sz000001	2024-02-01	0.90

# 3. Monthly and Currency Aggregation
query TTRR
SELECT symbol, date_trunc('month', trade_date)::DATE AS month, currency, round(sum(amount), 2)
FROM daily_snapshot
GROUP BY symbol, month, currency
ORDER BY month;
----
sz000001	2024-01-01	CNY	12000.00
sz000001	2024-02-01	CNY	22000.00

# 4. ORDER BY close DESC
query TR
SELECT trade_date, close
FROM daily_snapshot
ORDER BY close DESC;
----
2024-01-03	9.18
2024-01-02	9.15
2024-02-01	9.10
